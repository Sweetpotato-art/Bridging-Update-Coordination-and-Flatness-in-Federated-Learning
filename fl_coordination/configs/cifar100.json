{
  "fedfv:gf": {
    "config": {
      "protocol": "CIFAR100-ResNet20-GlobalFlatness-v1",
      "dataset": "CIFAR100",
      "seed": 2,
      "clients": 20,
      "participants": 20,
      "num_classes": 100,
      "epochs": 300,
      "batch_size": 128,
      "eval_batch_size": 512,
      "validation_fraction": 0.1,
      "dirichlet_alpha": 0.5,
      "local_steps": 5,
      "head_mode": "private",
      "bn_policy": "client_local_running_statistics",
      "optimizer": "adam",
      "learning_rate": 0.001,
      "local_learning_rate": 0.001,
      "weight_decay": 0.0,
      "adaptive_sam": false,
      "rho": 0.05,
      "flat_lambda": 1.0,
      "fedfv_alpha": 0.1,
      "fedfv_tau": 10,
      "mgda_epsilon": 1.0,
      "operators": {
        "fedmdfg": {
          "theta": 11.25,
          "line_search": false
        },
        "fedawa": {
          "server_epochs": 1,
          "server_optimizer": "adam",
          "gamma": 1.0,
          "reg_distance": "cos"
        },
        "fedld": {
          "k_proportion": 0.8,
          "margin_regularizer": false,
          "history_decay": 0.99
        }
      },
      "image_size": 32,
      "normalization_mean": [
        0.5,
        0.5,
        0.5
      ],
      "normalization_std": [
        0.5,
        0.5,
        0.5
      ],
      "augmentation": "random_crop_pad4_horizontal_flip",
      "deterministic": true,
      "log_every_rounds": 20,
      "case": "CIFAR100-private",
      "fedgf_threshold": 0.0038716522161848844,
      "fedgf_window": 30,
      "fedgf_threshold_source": "training_only_first_epoch_fedfv_median",
      "perturbation_scope": "shared_encoder_only",
      "global_direction": "previous_fit_size_weighted_raw_local_delta",
      "fedgloss_admm": false,
      "coupling": "independent_g_and_h_coordination_then_sum"
    },
    "endpoint": "validation_selected",
    "engine": "fedgf"
  },
